---
import { useT, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const t = useT(Astro.props.lang);
---

<footer class="footer">
  <div class="wrap footer__inner">
    <p>© {new Date().getFullYear()} Nico Díaz</p>
    <p>{t('footer.made')}</p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    padding-block: var(--space-l);
    border-top: 1px solid var(--grafito-borde);
    color: var(--papel-tenue);
    font-size: var(--step--1);
  }
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-m);
  }
</style>

---
import { useT, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
---

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero__text">
    <h1 id="hero-title" class="hero__name seq" style="--i: 0">Nico Díaz</h1>
    <p class="hero__role seq" style="--i: 1">{t('hero.role')}</p>
    <p class="hero__intro seq" style="--i: 2">{t('hero.intro')}</p>
    <div class="hero__actions seq" style="--i: 3">
      <a class="btn btn--brass" href="#proyectos">
        {t('hero.cta')}
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 4v12m0 0 5-5m-5 5-5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </a>
      <a class="btn btn--ghost" href="#contacto">{t('hero.secondary')}</a>
    </div>
  </div>

  <figure class="print seq" style="--i: 1">
    <div class="print__mat">
      <img
        class="print__photo"
        src="/img/perfil.jpg"
        alt={t('hero.photo')}
        width="783"
        height="1024"
        fetchpriority="high"
        transition:name="portrait"
      />
    </div>
  </figure>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr);
    align-items: center;
    gap: var(--space-xl);
    min-height: min(calc(100dvh - 4.5rem), 56rem);
    padding-block: var(--space-xl);
  }

  .hero__name {
    font-size: var(--step-4);
    font-weight: 640;
    line-height: 0.92;
    letter-spacing: -0.008em;
    font-variation-settings: 'wdth' 84;
  }
  .hero__role {
    margin-top: var(--space-s);
    font-size: var(--step-2);
    font-weight: 400;
    line-height: 1.2;
    color: var(--laton-claro);
  }
  .hero__intro {
    margin-top: var(--space-m);
    max-width: 34rem;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--papel-suave);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-top: var(--space-l);
  }

  /* The framed black-and-white print from the shelf */
  .print {
    margin: 0;
    justify-self: end;
    width: min(100%, 26rem);
    padding: 14px;
    background: var(--grafito);
    border-radius: 3px;
    box-shadow:
      0 2px 0 rgb(255 255 255 / 0.04) inset,
      0 40px 70px -30px rgb(0 0 0 / 0.75),
      0 18px 30px -18px rgb(0 0 0 / 0.6);
    transform: rotate(1.2deg);
  }
  .print__mat {
    padding: clamp(1rem, 2.5vw, 1.75rem);
    background: #f1ece2;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.25) inset;
  }
  .print__photo {
    width: 100%;
    height: auto;
    aspect-ratio: 783 / 1024;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.35);
    transition: filter 900ms var(--ease-out);
  }
  /* The lamp warms the print to colour when you lean in */
  @media (hover: hover) and (pointer: fine) {
    .print:hover .print__photo {
      filter: grayscale(0) contrast(1);
    }
    /* ...unless the lamp is off: no light, no colour */
    :global(html[data-lamp='off']) .print:hover .print__photo {
      filter: grayscale(1) contrast(1.05);
    }
  }
  @media (hover: none) {
    .print__photo {
      filter: grayscale(0.15);
    }
  }

  /* One orchestrated entrance: lamp first, then the print, then the words */
  .seq {
    animation: settle 900ms var(--ease-out) both;
    animation-delay: calc(650ms + var(--i) * 90ms);
  }
  .print.seq {
    animation-name: hang;
    animation-duration: 1200ms;
  }
  :global(.intro-done) .seq {
    animation: none;
  }
  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(14px);
      filter: blur(4px);
    }
  }
  @keyframes hang {
    from {
      opacity: 0;
      transform: translateY(-18px) rotate(-1.5deg);
    }
  }

  @media (max-width: 52rem) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: var(--space-l);
      padding-top: var(--space-l);
    }
    .print {
      grid-row: 1;
      justify-self: start;
      width: min(68%, 17rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .seq {
      animation-name: fade;
    }
    @keyframes fade {
      from {
        opacity: 0;
      }
    }
  }
</style>

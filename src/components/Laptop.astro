---
// The laptop on the desk, with a project on its screen.
interface Props {
  src: string;
  alt: string;
  name?: string;
  eager?: boolean;
}

const { src, alt, name, eager = false } = Astro.props;
---

<div class="laptop">
  <div class="laptop__lid">
    <div class="laptop__screen reveal">
      <img
        src={src}
        alt={alt}
        width="1440"
        height="900"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        transition:name={name}
      />
    </div>
  </div>
  <div class="laptop__base" aria-hidden="true"></div>
</div>

<style>
  .laptop {
    width: 100%;
  }
  .laptop__lid {
    padding: 2.2% 2.2% 3%;
    border-radius: 18px 18px 6px 6px;
    background: linear-gradient(#24221f, #171513);
    box-shadow:
      inset 0 0 0 1px #3a3631,
      0 50px 80px -40px rgb(0 0 0 / 0.85);
  }
  .laptop__screen {
    overflow: hidden;
    border-radius: 4px;
    background: #0e0d0c;
  }
  .laptop__screen img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
  }
  /* Silver-grey base, like the laptop in the photo */
  .laptop__base {
    position: relative;
    height: clamp(10px, 1.6vw, 18px);
    margin-inline: -6%;
    border-radius: 2px 2px 14px 14px;
    background: linear-gradient(#a7a39d, #6f6b66 70%, #4a4743);
    box-shadow: 0 18px 30px -12px rgb(0 0 0 / 0.8);
  }
  .laptop__base::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 16%;
    height: 45%;
    translate: -50% 0;
    border-radius: 0 0 8px 8px;
    background: #5b5853;
  }
</style>

---
import { useT, routes, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  alternate: string;
}

const { lang, alternate } = Astro.props;
const t = useT(lang);
const home = routes.home[lang];
const links = [
  { href: `${home}#sobre-mi`, label: t('nav.about') },
  { href: `${home}#tecnologias`, label: t('nav.tech') },
  { href: `${home}#proyectos`, label: t('nav.projects') },
  { href: `${home}#contacto`, label: t('nav.contact') },
];
---

<header class="nav" data-nav>
  <div class="nav__inner">
    <a class="nav__mark" href={home} aria-label={`Nico Díaz, ${t('nav.home')}`}>
      <span class="nav__monogram" aria-hidden="true"><img src="/img/concepto-1A.svg" alt="" width="40" height="40" /></span>
      <span class="nav__name">Nico Díaz</span>
    </a>

    <nav aria-label={lang === 'es' ? 'Principal' : 'Main'}>
      <ul class="nav__links">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <button class="switch" type="button" aria-label={t('lamp.label')} aria-pressed="true" data-lamp-switch>
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.5.4.8 1 .8 1.7v.5h5.6v-.5c0-.7.3-1.3.8-1.7A6 6 0 0 0 12 3Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>

    <div class="lang" role="group" aria-label={t('lang.label')}>
      {
        lang === 'es' ? (
          <>
            <span class="lang__item is-current" aria-current="true">ES</span>
            <a class="lang__item" href={alternate} hreflang="en" lang="en" aria-label="English">EN</a>
          </>
        ) : (
          <>
            <a class="lang__item" href={alternate} hreflang="es" lang="es" aria-label="Español">ES</a>
            <span class="lang__item is-current" aria-current="true">EN</span>
          </>
        )
      }
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-block: 0.9rem;
    transition:
      background-color 300ms ease,
      box-shadow 300ms ease;
  }
  .nav.is-scrolled {
    background: rgb(23 21 19 / 0.82);
    backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 var(--grafito-borde);
  }
  .nav__inner {
    width: min(100% - 2 * var(--gutter), var(--max));
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: var(--space-m);
  }
  .nav__mark {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    font-weight: 600;
    margin-right: auto;
  }
  .nav__monogram {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--grafito);
    border: 1px solid var(--laton);
    overflow: hidden;
  }
  .nav__monogram img {
    width: 100%;
    height: 100%;
    display: block;
  }
  .nav__links {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav__links a {
    display: block;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    text-decoration: none;
    color: var(--papel-suave);
    font-size: 0.97rem;
    transition: color 200ms ease, background-color 200ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .nav__links a:hover {
      color: var(--papel);
      background: rgb(236 230 218 / 0.06);
    }
  }
  /* The lamp switch: brass by day, the only warm thing left at night */
  .switch {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    margin-right: calc(var(--space-m) * -0.5);
    padding: 0;
    border-radius: 50%;
    background: var(--grafito);
    border: 1px solid var(--grafito-borde);
    color: var(--laton-claro);
    cursor: pointer;
    transition:
      color 300ms ease,
      border-color 300ms ease,
      box-shadow 500ms var(--ease-out),
      transform 160ms var(--ease-out);
  }
  .switch svg {
    width: 1.15rem;
    height: 1.15rem;
  }
  .switch:active {
    transform: scale(0.94);
  }
  .switch:focus-visible {
    outline: 2px solid var(--laton-claro);
    outline-offset: 3px;
  }
  .switch[aria-pressed='false'] {
    color: var(--luz);
    border-color: rgb(243 221 176 / 0.45);
    box-shadow:
      0 0 0 4px rgb(243 221 176 / 0.06),
      0 0 22px rgb(243 221 176 / 0.28);
  }
  @media (hover: hover) and (pointer: fine) {
    .switch:hover {
      border-color: var(--laton);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .switch {
      transition: none;
    }
  }
  .lang {
    display: inline-flex;
    padding: 3px;
    border-radius: 999px;
    background: var(--grafito);
    border: 1px solid var(--grafito-borde);
  }
  .lang__item {
    min-width: 2.4rem;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--papel-suave);
    transition: color 200ms ease;
  }
  .lang__item.is-current {
    background: var(--laton);
    color: var(--grafito);
  }
  @media (hover: hover) and (pointer: fine) {
    a.lang__item:hover {
      color: var(--papel);
    }
  }

  @media (max-width: 52rem) {
    .nav__links {
      display: none;
    }
  }
  @media (max-width: 26rem) {
    .nav__name {
      display: none;
    }
  }
</style>

<script>
  const update = () =>
    document.querySelector('[data-nav]')?.classList.toggle('is-scrolled', window.scrollY > 24);
  window.addEventListener('scroll', update, { passive: true });
  document.addEventListener('astro:page-load', update);
</script>

---
import { useT, type Lang } from '../i18n/ui';
import { tech } from '../data/tech';

interface Props {
  lang: Lang;
}

const t = useT(Astro.props.lang);
---

<section id="tecnologias" class="section" aria-labelledby="tech-title">
  <div class="wrap tech">
    <div class="section__head tech__head">
      <h2 id="tech-title" class="section__title">{t('tech.title')}</h2>
      <p class="section__lead">{t('tech.lead')}</p>
    </div>

    <div class="shelf">
      <ul class="shelf__books">
        {
          tech.map((item, i) => (
            <li
              class={`book book--${item.tone}`}
              style={`--h: ${item.height}; --w: ${item.width}rem; --brand: #${item.hex}; --i: ${i}`}
            >
              <span class="book__title">{item.name}</span>
              <svg class="book__icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d={item.path} fill="currentColor" />
              </svg>
            </li>
          ))
        }
      </ul>
      <div class="shelf__board" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  .tech {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-xl);
    align-items: end;
  }
  .tech__head {
    margin-bottom: 0;
    padding-bottom: 2.5rem;
  }
  @media (max-width: 60rem) {
    .tech {
      grid-template-columns: 1fr;
      gap: var(--space-l);
    }
    .tech__head {
      padding-bottom: 0;
    }
  }

  .shelf {
    --shelf-h: clamp(15rem, 12rem + 10vw, 21rem);
    --k: 1.3;
    position: relative;
  }
  .shelf__books {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: var(--shelf-h);
    margin: 0;
    padding: 0 clamp(0.5rem, 3vw, 2.5rem);
    list-style: none;
    justify-content: center;
  }

  /* Each technology is a book spine standing on the shelf */
  .book {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    width: calc(var(--w) * var(--k));
    height: calc(var(--shelf-h) * var(--h));
    padding: 1.1rem 0 1rem;
    border-radius: 3px 3px 1px 1px;
    background: var(--spine);
    color: var(--ink);
    box-shadow:
      inset 3px 0 0 rgb(255 255 255 / 0.06),
      inset -4px 0 0 rgb(0 0 0 / 0.25),
      0 18px 24px -18px rgb(0 0 0 / 0.9);
    transform-origin: bottom center;
    transition: transform 260ms var(--ease-out);
  }
  /* Bands near the top and bottom, like cloth-bound spines */
  .book::before,
  .book::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: currentColor;
    opacity: 0.35;
  }
  .book::before {
    top: 0.55rem;
  }
  .book::after {
    bottom: 3rem;
  }

  .book--grafito {
    --spine: #1c1a17;
    --ink: var(--papel);
  }
  .book--nogal {
    --spine: #4a3527;
    --ink: var(--luz);
  }
  .book--papel {
    --spine: #ddd3c2;
    --ink: #2b221d;
  }
  .book--laton {
    --spine: #a8844f;
    --ink: #1b1611;
  }
  .book--hoja {
    --spine: #3d4f2e;
    --ink: #e6ecd9;
  }

  .book__title {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: clamp(0.95rem, 0.8rem + 0.5vw, 1.2rem);
    font-weight: 600;
    letter-spacing: 0.01em;
    white-space: nowrap;
    font-variation-settings: 'wdth' 85;
  }
  .book__icon {
    width: 1.35rem;
    height: 1.35rem;
    transition: color 260ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .book:hover {
      transform: translateY(-14px);
    }
    .book:hover .book__icon {
      color: var(--brand);
    }
    .book--papel:hover .book__icon,
    .book--laton:hover .book__icon {
      color: inherit;
    }
  }

  .shelf__board {
    height: 18px;
    border-radius: 2px;
    background: linear-gradient(#3a2b21, #2a1f18);
    box-shadow:
      inset 0 1px 0 rgb(243 221 176 / 0.12),
      0 24px 40px -14px rgb(0 0 0 / 0.85);
  }

  @media (max-width: 40rem) {
    .shelf {
      --shelf-h: 14rem;
      --k: 0.78;
    }
    .shelf__books {
      gap: 3px;
      padding-inline: 0.25rem;
    }

    .book__title {
      font-size: 0.9rem;
    }
    .book__icon {
      width: 1.1rem;
      height: 1.1rem;
    }
  }
</style>
